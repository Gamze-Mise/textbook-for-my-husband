// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WordBucket {
  KNOWN
  TO_STUDY
  FORGOTTEN
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  words            Word[]
  passwordResets   PasswordReset[]
}

model PendingSignup {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model PasswordReset {
  id           Int      @id @default(autoincrement())
  email        String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email])
}

model Word {
  id            Int        @id @default(autoincrement())
  userId        Int
  term          String
  meaning       String
  example       String?
  bucket        WordBucket @default(FORGOTTEN)
  audioPublicId String?
  exampleAudioPublicId String?
  /** Cloudinary public_id for word image (no URL stored). */
  imagePublicId String?
  /** 0–100 horizontal focal point for object-fit cover (null = center). */
  imageFocusX   Int?
  /** 0–100 vertical focal point (null = center; lower = show more top). */
  imageFocusY   Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, bucket])
  @@unique([userId, term])
}
