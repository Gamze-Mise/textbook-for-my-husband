DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# SMTP (verification + password reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="user@example.com"
SMTP_PASS="password"

# Cloudinary (word + example TTS audio)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Required on Vercel — server Translate uses a datacenter IP (wrong accent for some words).
# Local dev works without this (Translate from your home IP).
# 1. Google Cloud Console → enable "Cloud Text-to-Speech API"
# 2. Create API key → add here and in Vercel env
GOOGLE_CLOUD_TTS_API_KEY="your-gcp-api-key"
# GOOGLE_CLOUD_TTS_VOICE="en-US-Wavenet-D"
