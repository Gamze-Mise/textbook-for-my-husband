DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# SMTP (verification + password reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="user@example.com"
SMTP_PASS="password"

# Cloudinary (word + example TTS audio)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Optional: Google Cloud Text-to-Speech (fallback when Translate TTS fails)
# GOOGLE_CLOUD_TTS_API_KEY="your-gcp-api-key"
# GOOGLE_CLOUD_TTS_MODE="translate-first"   # default — sounds like Google Translate
# GOOGLE_CLOUD_TTS_MODE="cloud-first"       # always Cloud when key is set (often “multay” for “multi”)
# GOOGLE_CLOUD_TTS_FALLBACK="false"         # on Vercel, Cloud fallback is off by default
# GOOGLE_CLOUD_TTS_FALLBACK="true"          # allow Cloud when Translate fails (local default)
# GOOGLE_CLOUD_TTS_VOICE="en-US-Neural2-D"  # Cloud voice when Cloud is used
