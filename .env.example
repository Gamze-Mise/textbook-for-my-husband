DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=verify-full"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# SMTP (verification + password reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="user@example.com"
SMTP_PASS="password"

# Cloudinary (word + example TTS audio)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Optional: public demo at /preview (user #2's deck). Leave unset to disable.
# PREVIEW_USER_ID="2"
