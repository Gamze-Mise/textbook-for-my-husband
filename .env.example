DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# SMTP (verification + password reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="user@example.com"
SMTP_PASS="password"

# Cloudinary (word + example TTS audio)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"


GOOGLE_CLOUD_TTS_API_KEY="your-gcp-api-key"
# Default voice on server: en-US-Standard-D (override if needed)
# GOOGLE_CLOUD_TTS_VOICE="en-US-Standard-D"
# Local dev: translate-first (like Google Translate). Vercel: cloud-first when key is set.
# GOOGLE_CLOUD_TTS_MODE="translate-first"
